# ==========================================
# APEX VENTURES
# ENVIRONMENT
# ==========================================

NODE_ENV=production
PORT=5000
PAYMENT_MODE=sandbox


# ==========================================
# MONGODB
# ==========================================

MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/apexventures?retryWrites=true&w=majority


# ==========================================
# JWT
# ==========================================

JWT_ACCESS_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET


# ==========================================
# REDIS
# ==========================================

REDIS_URL=YOUR_REDIS_CONNECTION_URL


# ==========================================
# CORS
# ==========================================

ALLOWED_ORIGIN=https://YOUR-FRONTEND-DOMAIN.com


# ==========================================
# PAYSTACK
# ==========================================

PAYSTACK_PUBLIC_KEY=pk_test_YOUR_TEST_PUBLIC_KEY
PAYSTACK_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY

PAYSTACK_CALLBACK_URL=https://YOUR-DOMAIN.com/payment-callback


# ==========================================
# PESAPAL
# ==========================================

PESAPAL_CONSUMER_KEY=YOUR_TEST_CONSUMER_KEY
PESAPAL_CONSUMER_SECRET=YOUR_TEST_CONSUMER_SECRET

PESAPAL_ENVIRONMENT=sandbox

PESAPAL_CALLBACK_URL=https://YOUR-DOMAIN.com/api/v1/payments/pesapal-callback
PESAPAL_IPN_URL=https://YOUR-DOMAIN.com/api/v1/payments/pesapal-webhook
